/* fakeram-asap7-v1: estimated area and fitted output delay, no power model. */
library(fakeram_asap7_128x128) {
    technology(cmos);
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    capacitive_load_unit(1,pf);
    nom_process : 1;
    nom_temperature : 25;
    nom_voltage : 0.7;
    input_threshold_pct_rise : 50;
    input_threshold_pct_fall : 50;
    output_threshold_pct_rise : 50;
    output_threshold_pct_fall : 50;
    slew_lower_threshold_pct_rise : 20;
    slew_lower_threshold_pct_fall : 20;
    slew_upper_threshold_pct_rise : 80;
    slew_upper_threshold_pct_fall : 80;
    
    type(ADDRESS) {
        base_type : array;
        data_type : bit;
        bit_width : 7;
        bit_from : 6;
        bit_to : 0;
        downto : true;
    }
    
    type(DATA) {
        base_type : array;
        data_type : bit;
        bit_width : 128;
        bit_from : 127;
        bit_to : 0;
        downto : true;
    }
    cell(fakeram_asap7_128x128) {
        area : 687.970714;
        interface_timing : true;
        dont_use : true;
        memory() { type : ram; address_width : 7; word_width : 128; }
        pin(clk) {
            direction : input;
            clock : true;
            capacitance : 0.025;
            min_period : 0.157;
        }
        
        pin(ce_in) {
            
            direction : input;
            capacitance : 0.005;
            
        timing() {
            related_pin : "clk";
            timing_type : setup_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }

        timing() {
            related_pin : "clk";
            timing_type : hold_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }
        }
        pin(we_in) {
            
            direction : input;
            capacitance : 0.005;
            
        timing() {
            related_pin : "clk";
            timing_type : setup_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }

        timing() {
            related_pin : "clk";
            timing_type : hold_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }
        }
        bus(addr_in) {
            bus_type : ADDRESS;
            direction : input;
            capacitance : 0.005;
            
        timing() {
            related_pin : "clk";
            timing_type : setup_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }

        timing() {
            related_pin : "clk";
            timing_type : hold_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }
        }
        bus(wd_in) {
            bus_type : DATA;
            direction : input;
            capacitance : 0.005;
            
        timing() {
            related_pin : "clk";
            timing_type : setup_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }

        timing() {
            related_pin : "clk";
            timing_type : hold_rising;
            rise_constraint(scalar) { values("0.050"); }
            fall_constraint(scalar) { values("0.050"); }
        }
        }
        bus(rd_out) {
            bus_type : DATA;
            direction : output;
            max_capacitance : 0.5;
            memory_read() { address : addr_in; }
            timing() {
                related_pin : "clk";
                timing_type : rising_edge;
                timing_sense : non_unate;
                cell_rise(scalar) { values("0.232538"); }
                cell_fall(scalar) { values("0.232538"); }
                rise_transition(scalar) { values("0.050"); }
                fall_transition(scalar) { values("0.050"); }
            }
        }
    }
}
