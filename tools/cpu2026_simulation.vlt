// Simulation scheduling hints for the structural and equivalent word views.
// Unpacked reduction/selector trees are acyclic at element granularity.
// Splitting them prevents Verilator from treating the entire array as a
// self-dependent signal. These directives do not change RTL or synthesis.
// Keep assertions, memory contents, latencies, and the official driver intact.
// The LSQ commit trees have forward references; leave those two arrays intact
// to avoid invalid scalar subscripts emitted by Verilator 5.020 after splitting.
`verilator_config
split_var -module "cpu_core" -var "fetch_valid"
split_var -module "rv32_backend_joint" -var "live_tree"
split_var -module "rv32_backend_joint" -var "reads"
split_var -module "rv32_branch_predictor" -var "target_classes"
split_var -module "rv32_completion_network" -var "earlier_count"
split_var -module "rv32_completion_network" -var "free_prefix"
split_var -module "rv32_completion_network" -var "memory_tree"
split_var -module "rv32_completion_network" -var "meta_tree"
split_var -module "rv32_completion_network" -var "target_tree"
split_var -module "rv32_completion_network" -var "value_tree"
split_var -module "rv32_decode_bundle_register" -var "payload_tree"
split_var -module "rv32_fetch_frontend" -var "bypass_prefix"
split_var -module "rv32_fetch_frontend" -var "payload_tree"
split_var -module "rv32_frequency_add_simm12" -var "generate_stage"
split_var -module "rv32_frequency_add_simm12" -var "ones_prefix"
split_var -module "rv32_frequency_add_simm12" -var "propagate_stage"
split_var -module "rv32_frequency_add_simm12" -var "zeros_prefix"
split_var -module "rv32_frequency_array_read" -var "reads"
split_var -module "rv32_frequency_array_read_bank_masks" -var "reads"
split_var -module "rv32_frequency_barrel32" -var "left_stage"
split_var -module "rv32_frequency_barrel32" -var "right_stage"
split_var -module "rv32_frequency_event_select" -var "mux_tree"
split_var -module "rv32_frequency_first_two" -var "first_index"
split_var -module "rv32_frequency_first_two" -var "first_valid"
split_var -module "rv32_frequency_first_two" -var "second_index"
split_var -module "rv32_frequency_first_two" -var "second_valid"
split_var -module "rv32_frequency_line_insert32" -var "shift16"
split_var -module "rv32_frequency_line_insert32" -var "shift32"
split_var -module "rv32_frequency_line_insert32" -var "shift8"
split_var -module "rv32_frequency_narrow_array_read" -var "reads"
split_var -module "rv32_lsq" -var "ack_payload_tree"
split_var -module "rv32_lsq" -var "ack_valid_tree"
split_var -module "rv32_lsq" -var "allocation_prior_unresolved_store"
split_var -module "rv32_lsq" -var "pick_valid"
split_var -module "rv32_lsq" -var "recovery_keep_tree"
split_var -module "rv32_lsq" -var "recovery_kill_slot_tree"
split_var -module "rv32_lsq" -var "recovery_kill_tree"
split_var -module "rv32_lsq" -var "recovery_kill_wrap_tree"
split_var -module "rv32_lsq" -var "report_slot_tree"
split_var -module "rv32_lsq" -var "report_valid_tree"
split_var -module "rv32_lsq" -var "report_wrap_tree"
split_var -module "rv32_lsq" -var "saved_identity_tree"
split_var -module "rv32_physical_register_file" -var "ready_tree"
split_var -module "rv32_physical_register_file" -var "stored_tree"
split_var -module "rv32_rename_unit" -var "encoded"
split_var -module "rv32_rename_unit" -var "group_tree"
split_var -module "rv32_rename_unit" -var "local_tree"
split_var -module "rv32_rename_unit" -var "prefix_tree"
split_var -module "rv32_rename_unit" -var "remaining"
split_var -module "rv32_reservation_station" -var "count_match"
split_var -module "rv32_reservation_station" -var "count_tree"
split_var -module "rv32_reservation_station" -var "payload_tree"
split_var -module "rv32_reservation_station" -var "slot_tree"
split_var -module "rv32_reservation_station" -var "tree"
split_var -module "rv32_rob" -var "completion_mux"
split_var -module "rv32_rob" -var "packets"
split_var -module "rv32_rob" -var "slots"
split_var -module "rv32_frequency_line_insert32" -var "original"
split_var -module "rv32_frequency_line_insert32" -var "shifted"
isolate_assignments -module "rv32_fetch_frontend" -var "fetch_valid_o"
